[Unit]
Description=InfiniCall AI Frontend Next.js Service
After=network.target infinicall-backend.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/www/apps/infinicall/autocall-next
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
KillMode=process

# Internal Port and Host Binding
Environment=NODE_ENV=production
Environment=PORT=3101
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=-/www/apps/infinicall/autocall-next/.env

# Security and Resource Limits
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=infinicall-frontend

[Install]
WantedBy=multi-user.target
