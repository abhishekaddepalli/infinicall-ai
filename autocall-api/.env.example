# ==============================================================================
# InfiniCall AI Backend Environment Configuration (.env.example)
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT commit real production passwords or API secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
# Internal port for backend service (default: 3100)
PORT=3100
# Internal host binding (always bind to 127.0.0.1 for production reverse proxy)
HOST=127.0.0.1

# Public URL of the application as accessed by users and telephony webhooks (HTTPS)
# Example: https://app.example.com (or https://api.example.com if running separate subdomains)
APP_URL=https://app.example.com
FRONTEND_URL=https://app.example.com

# Allowed CORS Origins (comma-separated, without trailing slashes)
ALLOWED_ORIGINS=https://app.example.com

# ------------------------------------------------------------------------------
# 2. SECURITY & SECRETS (REQUIRED)
# Generate long, cryptographically random strings for production!
# e.g., openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_64_character_jwt_secret
SESSION_SECRET=replace_with_a_secure_random_session_secret
# 32-character encryption key for encrypting API tokens in the database
TOKEN_ENCRYPTION_KEY=replace_with_exact_32_char_key_123456

# Disable demo mode in production
APP_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (MongoDB) (REQUIRED)
# Use a dedicated database user with readWrite privileges, NEVER root!
# Syntax: mongodb://<user>:<password>@127.0.0.1:27017/<database>?authSource=<database>
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://infinicall_user:SECURE_DB_PASSWORD_HERE@127.0.0.1:27017/infinicall?authSource=infinicall

# ------------------------------------------------------------------------------
# 4. REDIS CONFIGURATION (BullMQ Campaign Queue Worker) (REQUIRED)
# Redis is used for background call campaigns, SMS dispatch, and scheduled jobs.
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 5. INITIAL SUPER ADMIN ACCOUNT (Auto-seeded on first launch)
# ------------------------------------------------------------------------------
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TEMPORARY_ADMIN_PASSWORD_123!

# ------------------------------------------------------------------------------
# 6. INITIAL DEFAULT USER ACCOUNT (Optional auto-seed)
# ------------------------------------------------------------------------------
DEFAULT_USER_NAME=Default User
DEFAULT_USER_EMAIL=user@example.com
DEFAULT_USER_PASSWORD=CHANGE_THIS_TEMPORARY_USER_PASSWORD_123!

# ------------------------------------------------------------------------------
# 7. TELEPHONY PROVIDER CREDENTIALS (System Fallbacks)
# Note: Users and Admins can also configure credentials directly in the Dashboard.
# ------------------------------------------------------------------------------
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_APP_SID=

# Plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_APP_ID=

# Vobiz AI
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 8. AI & VOICE SYNTHESIS PROVIDERS (System Fallbacks)
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_AI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 9. WHATSAPP CLOUD API CONFIGURATION
# ------------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=replace_with_secure_verify_token

# ------------------------------------------------------------------------------
# 10. PAYMENT GATEWAYS (Optional)
# ------------------------------------------------------------------------------
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=

# ------------------------------------------------------------------------------
# 11. EMAIL & SMTP NOTIFICATIONS (Optional)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="InfiniCall AI"

# ------------------------------------------------------------------------------
# 12. SOCIAL OAUTH (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
